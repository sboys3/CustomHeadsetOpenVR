{
  "jsonid" : "input_profile",
  "controller_type": "pimax_hmd",
  "input_bindingui_mode" : "hmd",
  "input_bindingui_right" :
  {
    "image": "{CustomHeadsetOpenVR}/icons/hmd.svg"
  },
  "input_source": {
    "/input/volume_up": {
      "type": "button",
      "binding_image_point": [ 120, 75 ]
    },
    "/input/volume_down": {
      "type": "button",
      "binding_image_point": [ 144, 75 ]
    },
    "/input/system": {
      "type": "button",
      "binding_image_point": [ 132, 75 ]
    },
    "/input/tap": {
      "type": "button",
      "binding_image_point": [ 132, 75 ]
    },
    "/proximity": {
      "type": "button",
      "binding_image_point": [ 132, 74 ]
    },
    "/pose/raw": {
      "type": "pose",
      "binding_image_point": [ 132, 75 ]
    }
  },
  "default_bindings":
  [
    {
      "app_key": "openvr.component.vrcompositor",
      "binding_url": "vrcompositor_bindings_pimaxhmd.json"
    }
  ]
}
